# SPSRT frontend
#
# Este archivo es solo de referencia: Angular no lo lee.
# Los valores reales están en src/environments/environment*.ts
# y se seleccionan con fileReplacements en angular.json, según
# la configuración del build (development o production).
#
# Para probar contra otro backend, cambia temporalmente la URL
# en src/environments/environment.ts.

# URL base del API Gateway (desarrollo local)
API_GATEWAY_URL=http://localhost:8080

# Prefijo de endpoints REST
API_PREFIX=/api

# Timeout HTTP por request (ms)
HTTP_TIMEOUT_MS=15000

# Reintentos automaticos para errores transitorios (5xx, 0)
HTTP_RETRY_COUNT=1

# En produccion (environment.prod.ts) la URL pasa a HTTPS:
# API_GATEWAY_URL=https://api.spsrt.unir.edu.pe
