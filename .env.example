# SPSRT frontend
#
# Este archivo es SOLO documentacion humana. Angular NO lo lee:
# los valores reales viven en src/environments/environment*.ts y
# se seleccionan via fileReplacements en angular.json segun la
# configuration del build (development | production).
#
# Si queres probar contra un backend distinto sin rebuildear,
# editalo temporalmente en src/environments/environment.ts.

# URL base del API Gateway (desarrollo local)
API_GATEWAY_URL=http://localhost:8080

# Prefijo de endpoints REST
API_PREFIX=/api

# Timeout HTTP por request (ms)
HTTP_TIMEOUT_MS=15000

# Modo de datos: 'mock' (usa *-mock.service.ts locales) | 'real' (HTTP al backend)
API_MODE=real

# Reintentos automaticos para errores transitorios (5xx, 0)
HTTP_RETRY_COUNT=1

# En produccion (environment.prod.ts) la URL pasa a HTTPS:
# API_GATEWAY_URL=https://api.spsrt.unir.edu.pe
